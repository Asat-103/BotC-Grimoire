{% set infoTokens = [
    {
        id: 'isdemon',
        colour: 'red',
        markup: 'info_tokens.info_tokens.isdemon'|trans
    },
    {
        id: 'isminion',
        colour: 'red',
        markup: 'info_tokens.info_tokens.isminion'|trans
    },
    {
        id: 'notinplay',
        colour: 'blue',
        markup: 'info_tokens.info_tokens.notinplay'|trans
    },
    {
        id: 'selectedyou',
        colour: 'green',
        markup: 'info_tokens.info_tokens.selectedyou'|trans
    },
    {
        id: 'playeris',
        colour: 'purple',
        markup: 'info_tokens.info_tokens.playeris'|trans
    },
    {
        id: 'youare',
        colour: 'dark-purple',
        markup: 'info_tokens.info_tokens.youare'|trans
    },
    {
        id: 'useability',
        colour: 'dark-orange',
        markup: 'info_tokens.info_tokens.useability'|trans
    },
    {
        id: 'makechoice',
        colour: 'dark-orange',
        markup: 'info_tokens.info_tokens.makechoice'|trans
    },
    {
        id: 'nominatetoday',
        colour: 'orange',
        markup: 'info_tokens.info_tokens.nominatetoday'|trans
    },
    {
        id: 'votetoday',
        colour: 'dark-orange',
        markup: 'info_tokens.info_tokens.votetoday'|trans
    }
] %}

{% embed 'includes/details.html.twig' with {
    summary: 'info_tokens.title'|trans,
    id: 'info-tokens'
} %}
    {% block body %}
    <ul class="button-list" id="info-token-button-holder" data-info-tokens='{{ infoTokens|json_encode() }}'></ul>
    <h3 class="info-token-heading">{{ 'info_tokens.custom'|trans }}</h3>
    <ul class="button-list" id="info-token-custom-holder">
        <li>
            <button type="button" class="button button--full-height" id="add-info-token">{{ 'info_tokens.add_custom'|trans }}</button>
        </li>
    </ul>
    <div class="folio-actions">
        <button class="button" type="button" id="export-info-tokens">{{ 'redesign.export'|trans }}</button>
        <label class="folio-file">{{ 'redesign.import'|trans }} <input type="file" id="import-info-tokens" accept="application/json,.json" data-no-store></label>
    </div>
    <form id="quick-message-form" class="folio-form">
        <label>{{ 'redesign.type_message'|trans }} <input class="input" name="message" maxlength="1200" required data-no-store></label>
        <button class="button" type="submit">{{ 'redesign.quick_message'|trans }}</button>
    </form>
    <form id="quick-number-form" class="folio-form">
        <label>{{ 'redesign.quick_number'|trans }} <input class="input" name="number" type="number" required data-no-store></label>
        <button class="button" type="submit">{{ 'redesign.reveal'|trans }}</button>
    </form>
    <div class="folio-actions">
        <button class="button" type="button" data-quick-info="{{ 'redesign.quick_yes'|trans }}">{{ 'redesign.quick_yes'|trans }}</button>
        <button class="button" type="button" data-quick-info="{{ 'redesign.quick_no'|trans }}">{{ 'redesign.quick_no'|trans }}</button>
        <button class="button" type="button" data-quick-info="{{ 'messages.good_team'|trans }}">{{ 'messages.good_team'|trans }}</button>
        <button class="button" type="button" data-quick-info="{{ 'messages.evil_team'|trans }}">{{ 'messages.evil_team'|trans }}</button>
    </div>
    {% endblock %}
{% endembed %}

<div id="info-token-dialog-holder"></div>

<template id="info-token-button-template">
    <li>
        <button type="button" class="button button--full-height js--info-token--button"></button>
    </li>
</template>

<template id="info-token-dialog-template">
    {% embed 'includes/dialog.html.twig' with {
        class: 'info-token js--info-token--dialog',
        background: 'hide',
        hideClickBackground: false,
        includeHeader: false
    } %}
        {% block body %}
        <div class="info-token__perspective">
            <div class="info-token__card" aria-live="polite">
                <div class="info-token__face info-token__front"></div>
                <div class="info-token__face info-token__back" aria-hidden="true"></div>
            </div>
        </div>
        <div class="info-token__controls">
            <span class="info-token__side" aria-live="polite"></span>
            <button class="button info-token__flip" type="button" aria-pressed="false" hidden>{{ 'redesign.flip'|trans }}</button>
            <button class="button" type="button" data-dialog-hide>{{ 'redesign.handback'|trans }}</button>
        </div>
        {% endblock %}
    {% endembed %}
</template>

{% embed 'includes/dialog.html.twig' with { id: 'info-token-editor', title: 'redesign.editor'|trans, background: 'blur' } %}
    {% block body %}
    <form id="info-editor-form" class="folio-form">
        <label>{{ 'redesign.front'|trans }}<textarea class="input" name="front" required maxlength="1200" rows="3" data-no-store></textarea></label>
        <label>{{ 'redesign.back'|trans }}<textarea class="input" name="back" maxlength="1200" rows="3" data-no-store></textarea></label>
        <label>{{ 'redesign.appearance'|trans }}
            <select class="input" name="color" data-no-store>
                <option value="ink">{{ 'redesign.token_ink'|trans }}</option>
                <option value="wine">{{ 'redesign.token_wine'|trans }}</option>
                <option value="parchment">{{ 'redesign.token_parchment'|trans }}</option>
            </select>
        </label>
        <label><input type="checkbox" name="favourite" data-no-store> {{ 'redesign.favourite'|trans }}</label>
        <div class="folio-actions">
            <button type="submit" class="button folio-primary">{{ 'redesign.save'|trans }}</button>
            <button type="submit" class="button" id="preview-info-token">{{ 'redesign.preview'|trans }}</button>
        </div>
    </form>
    {% endblock %}
{% endembed %}
