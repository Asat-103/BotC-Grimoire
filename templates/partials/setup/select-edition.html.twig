<button type="button" class="button button--full-height" id="select-edition" data-dialog="#edition-list">{{ 'setup.buttons.select_edition'|trans }}</button>

{% embed 'includes/dialog.html.twig' with {
    id: 'edition-list',
    background: 'blur',
    title: 'setup.editions.title'|trans,
    class: 'edition-picker'
} %}
    {% import 'macros/forms.html.twig' as forms %}
    {% block body %}

    <form id="select-edition-form" enctype="multipart/form-data">

        <div class="edition-picker__modes" role="group" aria-label="{{ 'setup.editions.title'|trans }}">
            {% for mode, label in {official: 'official', upload: 'upload', url: 'url', paste: 'paste', botc: 'botc'} %}
                <button type="button" class="button" data-edition-mode="{{ mode }}" aria-pressed="{{ mode == 'official' ? 'true' : 'false' }}">{{ ('setup.editions.' ~ label)|trans }}</button>
            {% endfor %}
        </div>
        <p id="edition-data-error" class="folio-status" role="alert" hidden>{{ 'redesign.data_missing'|trans }}</p>
        <section class="edition-picker__panel" data-id="official">
            <fieldset class="edition-picker__choices">
                <legend class="sr-only">{{ 'setup.editions.official'|trans }}</legend>
                {% for edition, title in {tb: 'trouble_brewing', snv: 'sects_and_violets', bmr: 'bad_moon_rising'} %}
                    <label class="edition-option edition-option--{{ edition }}">
                        <input type="radio" class="sr-only" name="edition" value="{{ edition }}" data-no-store {{ loop.first ? 'checked required' }}>
                        {% include 'partials/edition-emblem.html.twig' with { edition: edition } only %}
                        <span>
                            <strong class="edition-option__title">{{ ('setup.editions.' ~ title)|trans }}</strong>
                            <small>{{ ('redesign.editions.' ~ edition)|trans }}</small>
                        </span>
                        <span class="edition-option__check" aria-hidden="true">✓</span>
                    </label>
                {% endfor %}
            </fieldset>
        </section>
        <section class="edition-picker__panel" data-id="upload" hidden>
            <div class="edition-details__body">
                <label for="custom-script-upload" class="sr-only">{{ 'setup.editions.upload'|trans }}</label>
                {{ forms.file({
                    name: "custom-script-upload",
                    id: "custom-script-upload",
                    accept: "application/json",
                    required: true
                }) }}
            </div>
        </section>
        <section class="edition-picker__panel" data-id="url" hidden>
            <div class="edition-details__body">
                <label for="custom-script-url" class="sr-only">{{ 'setup.editions.url'|trans }}</label>
                <input type="url" name="custom-script-url" id="custom-script-url" class="input" placeholder="https://www.example.com/script.json" required data-no-store>
            </div>
        </section>
        <section class="edition-picker__panel" data-id="paste" hidden>
            <div class="edition-details__body">
                <label for="custom-script-paste" class="sr-only">{{ 'setup.editions.paste'|trans }}</label>
                <textarea name="custom-script-paste" id="custom-script-paste" class="input" placeholder='["washerwoman","investigator","librarian","chef"]' required></textarea>
            </div>
        </section>
        <section class="edition-picker__panel" data-id="botc" hidden>
            <div class="edition-details__body">
                <label for="botc-scripts">{{ 'setup.editions.lookup'|trans }}</label>
                <div class="media mb-4">
                    <input type="text" name="botc-scripts" id="botc-scripts" class="input media__body" required data-no-store>
                    <button type="button" class="button media__side" id="botc-scripts-lookup">
                        <span class="d-flex">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-label="{{ 'setup.editions.select'|trans }}" class="locale-form__icon"><!--! Font Awesome Pro 6.1.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2022 Fonticons, Inc. --><title id="tick-icon">{{ 'setup.editions.select'|trans }}</title><path style="fill: currentColor;" d="M438.6 105.4C451.1 117.9 451.1 138.1 438.6 150.6L182.6 406.6C170.1 419.1 149.9 419.1 137.4 406.6L9.372 278.6C-3.124 266.1-3.124 245.9 9.372 233.4C21.87 220.9 42.13 220.9 54.63 233.4L159.1 338.7L393.4 105.4C405.9 92.88 426.1 92.88 438.6 105.4H438.6z"/></svg>
                        </span>
                    </button>
                </div>
                <div class="edition-picker__results">
                    <p class="align-centre" id="botc-scripts-loader" hidden>
                        <span class="loader" aria-hidden="true">
                            <span class="loader" aria-hidden="true"></span>
                        </span>
                    </p>
                    <p id="botc-scripts-empty" hidden>{{ 'setup.editions.no_results'|trans }}</p>
                    <ul id="botc-scripts-results" class="no-list edition-details__entries" hidden></ul>
                </div>
            </div>
        </section>

        <template id="botc-scripts-entry">
            <li>
                <label class="edition-option edition-option--result js--botc-scripts--label">
                    <span class="sr-only">
                        <input
                            type="radio"
                            name="botc-script"
                            class="radio__input js--botc-scripts--input"
                        >
                        <span class="radio__render"></span>
                    </span>
                    <span class="radio__label">
                        <strong class="edition-details__name js--botc-scripts--name"></strong>
                        <small class="edition-details__author js--botc-scripts--author"></small>
                    </span>
                    <span class="edition-option__check" aria-hidden="true">✓</span>
                </label>
            </li>
        </template>

        <p class="edition-picker__confirm">
            <button type="submit" class="button folio-primary" id="confirm-edition">
                <span class="button__text">{{ 'redesign.use_script'|trans }}</span>
                <span class="button__loader" role="progressbar" aria-valuetext="Loading" aria-busy="false" aria-live="assertive" aria-valuemin="0" aria-valuemax="1">
                    <span class="loader" aria-hidden="true"></span>
                </span>
            </button>
        </p>

    </form>
    {% endblock %}
{% endembed %}
